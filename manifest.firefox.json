{
  "manifest_version": 2,
  "name": "FocusLock",
  "version": "1.2.0",
  "description": "Password-protected site blocker with local history cleanup.",
  "permissions": [
    "storage",
    "webNavigation",
    "tabs",
    "history",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "FocusLock"
  },
  "web_accessible_resources": ["blocked.html"],
  "browser_specific_settings": {
    "gecko": {
      "id": "focuslock@densepose.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
